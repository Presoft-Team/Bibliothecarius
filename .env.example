POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=ragchat

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=ragchat
KEYCLOAK_CLIENT_ID=ragchat-backend

# Service-account client the backend uses to call Keycloak's Admin REST API (list/invite users,
# grant/revoke roles). Scoped to manage-users/view-users only, not the bootstrap superadmin above.
# Must match the secret baked into keycloak/realm-export.json's ragchat-backend-admin client.
KEYCLOAK_ADMIN_CLIENT_ID=ragchat-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=ragchat-backend-admin-dev-secret

# Dev-only seed accounts created by keycloak/realm-export.json on first boot:
#   testuser / testpass  (role: user)
#   admin    / adminpass (role: admin, user)
# Change or remove these before any non-local deployment.

# Cloud LLM provider keys are stored per-user in the DB (encrypted), not here.
# This key encrypts those stored provider API keys at rest. The value below is a
# committed dev-only default (see app/core/config.py) so the stack runs out of the box;
# generate your own before storing anything beyond local scratch data:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=uYCiUWGe3Lo-dTnRC-F9he-yyxnyN1cjR3fYX5s7GHQ=
